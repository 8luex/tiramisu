# AWS Lambda Environment Variables Configuration
# Copy these to your Lambda Function's Environment Variables settings

# Discord Configuration
# Get from: https://discord.com/developers/applications
DISCORD_PUBLIC_KEY=your_public_key_here
DISCORD_TOKEN=your_bot_token_here
APPLICATION_ID=your_application_id_here

# MySQL Database Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=N
# Use connection_limit=5 for Lambda (prevents connection exhaustion)
DATABASE_URL=mysql://user:password@host:3306/database?connection_limit=5

# Environment
NODE_ENV=production

# Timezone (for dayjs)
TZ=Asia/Bangkok
