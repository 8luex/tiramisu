# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID (same as Client ID in Discord Developer Portal)
APPLICATION_ID=your_application_id_here

# MySQL Database Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=3
# Connection limit is set to 3 for optimal memory usage on Discloud
DATABASE_URL=mysql://user:password@localhost:3306/finance_bot?connection_limit=3

# Environment (development or production)
NODE_ENV=production
